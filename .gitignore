# --- 1. Ignore Everything by Default ---
*

# --- 2. Whitelist (Allow) Essential Source Code ---
!app.py
!chat.py
!config.py
!indexing.py
!loaders.py
!models.py
!extensions/
!extensions/**
!pages/
!pages/**
!pocketbase/
!pocketbase/**
!tests/
!tests/**

# --- 3. Whitelist Configuration & Deployment Files ---
!requirements.txt
!Dockerfile
!docker-compose.prod.yml
!docker-compose.dev.yml
!README.md
!.gitignore
!.dockerignore
!.coveragerc
!.env.example

# --- 4. Whitelist Data Directory Structure (but not content) ---
!data/
!data/.gitkeep

# --- 5. Whitelist CI/CD Pipeline ---
!.gitlab-ci.yml

# --- 6. Explicitly Ignore Generated Artifacts ---
faiss_index/
venv/
__pycache__/
*.pyc
.vscode/
.idea/
.git/
*.log
