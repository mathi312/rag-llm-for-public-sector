# --- 1. Ignore Everything by Default ---
*

# --- 2. Whitelist (Allow) Essential Source Code ---
!app.py
!chat.py
!config.py
!indexing.py
!loaders.py
!models.py
!application/
!application/**
!infrastructure/
!infrastructure/**
!domain/
!domain/**
!presentation/
!presentation/**
!pocketbase/
!pocketbase/**
!tests/
!tests/**

# --- 3. Whitelist Configuration & Deployment Files ---
!requirements.txt
!Dockerfile
!docker-compose.yml
!docker-compose.prod.yml
!docker-compose.dev.yml
!README.md
!MANUAL.md
!.gitignore
!.dockerignore
!.coveragerc
!.env.example

# --- 4. Whitelist Data Directory Structure (but not content) ---
!data/
!data/.gitkeep
!pocketbase/pb_migrations/
!pocketbase/pb_migrations/**

# --- 5. Whitelist CI/CD Pipeline ---
!.gitlab-ci.yml
!.pylintrc
!.github/
!.github/**

# --- 6. Explicitly Ignore Generated Artifacts ---
# PocketBase runtime DB/files (local state only)
pocketbase-data/

# Local generated outputs
coverage_html_report/
faiss_index/
venv/
__pycache__/
*.pyc
.vscode/
.idea/
.git/
*.log
